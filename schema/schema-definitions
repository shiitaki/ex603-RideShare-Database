riders(
    rider_id: INTEGER PK,
    first_name: VARCHAR,
    last_name: VARCHAR,
    email: VARCHAR
)

drivers(
    driver_id: INTEGER PK,
    first_name: VARCHAR,
    last_name: VARCHAR,
    license_number: VARCHAR
)

trips(
    trip_id: INTEGER PK,
    rider_id: INTEGER FK,
    driver_id: INTEGER FK,
    fare_amount: DECIMAL,
