)

driver_badges(
    badge_id: INTEGER PK,
    badge_name: VARCHAR,
    description: VARCHAR
)

driver_badge_awards(
    award_id: INTEGER PK,
    driver_id: INTEGER FK,
    badge_id: INTEGER FK,
    awarded_at: TIMESTAMP
)
